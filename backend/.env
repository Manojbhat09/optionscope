# Copy this file to .env and fill in your API keys

# Anthropic Claude (claude-opus-4-8) - recommended
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI GPT-4o
OPENAI_API_KEY=sk-...

# OpenRouter (large free+paid model catalog, fetched live from /models)
REACT_APP_OPENROUTER_API_KEY=sk-or-...

# InferX (deepseek-v4-flash, OpenAI-compatible, billed per token)
INFERX_API_KEY=ix_...
# INFERX_BASE_URL=https://model.inferx.net/endpoints/v1

# Z.ai coding plan (GLM-4.6 etc, OpenAI-compatible, flat subscription)
ZAI_API_KEY=...
# ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4

# ── Stock history providers (for 1h data older than 730 days) ──────────────────
# Alpaca Markets — free paper account at alpaca.markets, gives 1h back to 2016 via IEX
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ── Robinhood login default (used when the frontend form is left blank) ───────
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=

# Polygon.io — free key at polygon.io, covers ~2 years of 1h history
POLYGON_API_KEY=

# SearchAPI.io (DuckDuckGo engine) — used by Spot Replay research agent
SEARCHAPI_API_KEY=

# CommandCode Provider API (https://commandcode.ai/docs/provider)
# COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1
COMMANDCODE_API_KEY=
